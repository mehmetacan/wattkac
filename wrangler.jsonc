// Cloudflare Workers ayarı: site/ klasörü statik olarak sunulur; worker/index.js yalnızca /api/* (geri bildirim, analiz, panel) ve alan adı yönlendirmesi içindir.
{
  "name": "wattkac",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "build": {
    "command": "cp data/kampanyalar.json site/kampanyalar.json && python3 tools/seo_sayfalar.py"
  },
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    // Ücretsiz plan: worker yalnızca /api/* için çalışır; sayfalar ve dosyalar doğrudan sunulur (worker isteği sayılmaz)
    "run_worker_first": ["/api/*"]
  },
  // Geri bildirim formu kayıtları (worker/index.js → /api/geri-bildirim)
  "d1_databases": [
    { "binding": "DB", "database_name": "wattkac-geri-bildirim", "database_id": "d33da3c0-3f38-4200-8bfc-78ab66f7385d" }
  ]
  // Bildirim gönderimi: her gün 09:00–21:45 (Türkiye saati) arası 15 dakikada bir; her çalışmada en çok 35 bildirim (worker/index.js → bildirimGonder)
  ,"triggers": { "crons": ["*/15 6-18 * * *"] }
  ,"routes": [
    { "pattern": "wattkac.com", "custom_domain": true },
    { "pattern": "www.wattkac.com", "custom_domain": true }
    // wattkac.xyz Cloudflare'de "Active" olunca eklenecek:
    // ,{ "pattern": "wattkac.xyz", "custom_domain": true }
    // ,{ "pattern": "www.wattkac.xyz", "custom_domain": true }
  ]
}

// Cloudflare Workers ayarı: site/ klasörü statik olarak sunulur, worker/index.js yalnızca alan adı yönlendirmesi yapar.
{
  "name": "wattkac",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "build": {
    "command": "cp data/kampanyalar.json site/kampanyalar.json"
  },
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Geri bildirim formu kayıtları (worker/index.js → /api/geri-bildirim)
  "d1_databases": [
    { "binding": "DB", "database_name": "wattkac-geri-bildirim", "database_id": "d33da3c0-3f38-4200-8bfc-78ab66f7385d" }
  ]
  ,"routes": [
    { "pattern": "wattkac.com", "custom_domain": true },
    { "pattern": "www.wattkac.com", "custom_domain": true }
    // wattkac.xyz Cloudflare'de "Active" olunca eklenecek:
    // ,{ "pattern": "wattkac.xyz", "custom_domain": true }
    // ,{ "pattern": "www.wattkac.xyz", "custom_domain": true }
  ]
}
